# LLM provider: "openai" (any OpenAI-compatible API) or "gigachat" (Sber GigaChat)
TRAILER_LLM__PROVIDER=openai
TRAILER_LLM__MODEL=gpt-4o-mini
TRAILER_LLM__API_KEY=sk-...
# Optional: override for OpenAI-compatible endpoints (local, proxies, etc.)
# TRAILER_LLM__BASE_URL=https://api.openai.com/v1

# --- GigaChat example ---
# TRAILER_LLM__PROVIDER=gigachat
# TRAILER_LLM__MODEL=GigaChat-2-Max
# TRAILER_LLM__API_KEY=<Authorization key (base64 client_id:client_secret)>
# TRAILER_LLM__SCOPE=GIGACHAT_API_PERS
# SSL verification is disabled by default for GigaChat (its chain is not trusted
# by common CA stores). Enable it only if the Russian Trusted CA is installed:
# TRAILER_LLM__VERIFY_SSL_CERTS=true
# TRAILER_LLM__CA_BUNDLE_FILE=/path/to/russian_trusted_root_ca.pem

# Pipeline defaults (can also be passed via CLI arguments)
# TRAILER_LANGUAGE=ru
# TRAILER_TARGET_DURATION=90
# TRAILER_DURATION_TOLERANCE=10
# TRAILER_WORKSPACE_DIR=workspace

# --- Langfuse tracing (optional) ---
# Leave keys empty to disable tracing (the pipeline runs as usual).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Self-hosted Langfuse: base URL of the Langfuse instance
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_TRACING_ENVIRONMENT=default
# LANGFUSE_DEBUG=false
